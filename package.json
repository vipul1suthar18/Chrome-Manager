{
  "name": "seo-workspace",
  "version": "1.0.0",
  "description": "A local SEO client and project management tool.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder build --win --publish never",
    "build:css": "node scripts/copy-assets.cjs && tailwindcss -c tailwind.config.cjs -i ./src/tailwind.css -o ./src/tailwind.generated.css --minify",
    "prestart": "npm run build:css",
    "prebuild": "npm run build:css"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fortawesome/fontawesome-free": "^7.3.1",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "tailwindcss": "^3.4.17"
  },
  "build": {
    "appId": "com.seo.workspace",
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**/*"
    ]
  }
}
